# Blip job worker + scheduler.
# Runs the durable Postgres-backed queue that drives create/run/heal against
# Bright Data. Deployed on the DigitalOcean droplet; frontend/API live on Vercel.
FROM node:22-alpine

WORKDIR /app

# Install prod deps first (better layer caching).
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# tsx is a devDependency but the worker needs it to run TypeScript directly.
RUN npm i --no-save tsx

COPY tsconfig.json ./
COPY worker.ts ./
COPY src ./src

ENV NODE_ENV=production
CMD ["npx", "tsx", "worker.ts"]
