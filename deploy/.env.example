# Copy to /opt/blip/.env on the droplet. Never commit real values.
POSTGRES_DB=blip
POSTGRES_USER=blip
POSTGRES_PASSWORD=
DATABASE_URL=postgres://blip:CHANGE_ME@postgres:5432/blip
BRIGHTDATA_API_TOKEN=
# Email-on-change via Resend. RESEND_FROM must be a verified domain (or
# onboarding@resend.dev for tests, which only delivers to your own address).
RESEND_API_KEY=
RESEND_FROM=Blip <blip@allensaji.dev>
