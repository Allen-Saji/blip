# Blip environment
# Copy to .env and fill in real values.

# Bright Data API token (from https://brightdata.com/cp/setting/users)
BRIGHTDATA_API_TOKEN=

# Postgres connection string
DATABASE_URL=

# GitHub OAuth (Auth.js)
GITHUB_ID=
GITHUB_SECRET=
AUTH_SECRET=

# Resend email
RESEND_API_KEY=
RESEND_FROM=Blip <blip@allensaji.dev>

# AI change summaries (Command Code Provider API, free model)
CMD_API_KEY=
# Optional overrides
CMD_PROVIDER_URL=https://api.commandcode.ai/provider/v1/chat/completions
CMD_SUMMARY_MODEL=poolside/laguna-s-2.1-free
